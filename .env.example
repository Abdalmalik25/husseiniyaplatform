# ── ALHUSAINIA Platform — Environment Variables ─────────────────────────
# انسخ هذا الملف إلى .env واملأ القيم. للإنتاج على Vercel أضفها من لوحة الإعدادات.

# ── Server ──
NODE_ENV=production
PORT=3000

# ── Database (Neon PostgreSQL) — مطلوب ──
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth — مطلوب ──
JWT_SECRET=change-me-to-a-long-random-string
# ES256 signing keys (PEM, ECDSA P-256). JWT_SECRET above is still used for
# cookie/CSRF signing. If JWT_PRIVATE_KEY/JWT_PUBLIC_KEY are set they take
# precedence over the on-disk .keys/jwt-keys.json file. Generate with:
#   node scripts/generate-jwt-keys.mjs
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Opt-in: reject sessions whose device fingerprint no longer matches. Keep OFF
# for now (proxy/IP changes can cause false positives). OFF by default.
JWT_ENFORCE_DEVICE_BINDING=false
OWNER_OPEN_ID=your-owner-openid
# كلمة سر المالك (اختياري — تُستخدم لتفويض مهام الصيانة الحساسة)
OWNER_PASSWORD=

# ── Cron & Agent — مطلوب في الإنتاج ──
# بدون CRON_SECRET يتوقف جدول الأتمتة الليلي في الإنتاج (فشل-مغلق 503):
#  - مثلاً: تنبيهات المخزون والمدفوعات المتأخرة، القيود المجدولة، المصاريف الدورية، النسخ الاحتياطي.
# Vercel يرسل تلقائياً `Authorization: Bearer <CRON_SECRET>` عند ضبطه.
CRON_SECRET=change-me-to-a-long-random-string
# بدون AGENT_SECRET يتم تعطيل نقطة نهاية الموظَّف (agent) كلياً.
AGENT_SECRET=change-me-to-a-long-random-string

# ── النسخ الاحتياطي المشفَّر (برنامج مُختبَر — fail-closed في الإنتاج) ──
# مفتاح تشفير النسخ الاحتياطي (AES-256-GCM، ≥16 حرفاً). بدونه في الإنتاج:
# النسخ معطَّلة تماماً + الكرون الليلي يسجّل فشلاً، وعند فشلين متتاليين
# يُرفع إنذار Sentry (راجع docs/OPERATIONS_RUNBOOK.md — RPO ≤24h / RTO ≤1h).
BACKUP_ENCRYPTION_KEY=change-me-to-a-long-random-secret
# مجلد محلي لبلوبات النسخ عند عدم ضبط S3 (اختياري)
BACKUP_DIR=

# ── OAuth (بوابة الدخول الموحَّدة) ──
OAUTH_SERVER_URL=https://your-oauth-provider
VITE_OAUTH_PORTAL_URL=https://your-oauth-provider
VITE_APP_ID=your-app-id

# ── النطاق العام للمنصة ──
# تُبنى منه روابط رسائل البريد (تحقق البريد / إعادة تعيين كلمة المرور).
# يجب أن يشير إلى نطاق المنصة نفسها (وليس بوابة OAuth).
APP_URL=https://alhusainiaye.vercel.app

# ── Transactional Email (SMTP) — production ready ──
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@your-domain.com

# ── LLM (اختياري — للميزات الذكية) ──
LLM_API_KEY=
LLM_API_URL=

# ── Sentry (اختياري لكن موصى به بشدة للإنتاج) ──
# DSN لتتبع الأخطاء ومراقبة الأداء
SENTRY_DSN=
# Client-side DSN (مطلوب للعميل)
VITE_SENTRY_DSN=
# Sentry Auth Token لرفع Source Maps (أضِفه في Vercel فقط)
SENTRY_AUTH_TOKEN=
# Sentry Organization و Project (للـ CI/CD)
SENTRY_ORG=
SENTRY_PROJECT=

# ── Web store notifications (اختياري) — يُستدعى عند كل طلب جديد ──
# مثال: https://hooks.slack.com/services/xxx أو بوابة واتساب
ORDER_WEBHOOK_URL=

# ── Storage (اختياري — رفع الملفات) ──
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── CORS للمتجر العام (اختياري) ──
# اتركه فارغاً للسماح لأي موقع بدمج المتجر، أو حدِّده بفواصل:
# STORE_CORS_ORIGINS=https://your-site.com,https://www.your-site.com
STORE_CORS_ORIGINS=


# E2E authenticated journey (local dev only)
# Seed the runner first: node --env-file=.env scripts/seed-e2e-user.mjs
E2E_USERNAME=
E2E_PASSWORD=
E2E_TENANT_ID=4