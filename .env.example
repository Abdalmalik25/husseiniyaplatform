# ─── AppHusseniya Environment Variables ───────────────────────────
# Copy this file to .env and fill in the values.

# Server
NODE_ENV=development
PORT=3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=your-secret-key-here
OWNER_OPEN_ID=your-owner-openid

# OAuth (Manus)
OAUTH_SERVER_URL=

# LLM (optional - for AI features)
LLM_API_KEY=
LLM_API_URL=

# Web store notifications (optional) - POSTed when a new store order is placed
# Example: https://hooks.slack.com/services/xxx or a WhatsApp gateway URL
ORDER_WEBHOOK_URL=

# Storage (optional - for file uploads)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Client-exposed (VITE_ prefix)
VITE_OAUTH_PORTAL_URL=
