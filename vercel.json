{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    {
      "source": "^/((?!api/|assets/|favicon\\.svg|icon-192\\.svg|icon-512\\.svg|manifest\\.json|offline\\.html|sw\\.js|__manus__/|.*\\.(?:js|css|png|jpe?g|svg|gif|webp|ico|woff2?|ttf|eot|map|txt|json|webmanifest|xml)).*)$",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "runtime": "nodejs20.x"
    }
  }
}
